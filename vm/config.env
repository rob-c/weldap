# Test VM definitions. Sourced by the vm/*.sh scripts.
# Sizes: memory in MiB, disk in MiB.

# VM1: native ARM64 (Apple hypervisor). Build machine + fast test loop.
VM1_NAME="weldap-win11-arm64"
VM1_ARCH="aarch64"
VM1_ISO="vm/iso/Win11_ARM64.iso"
VM1_EDITION="Windows 11 Pro"
VM1_COMPUTER="WELDAP-W11A64"
VM1_MEMORY=16384
VM1_CPUS=8
VM1_DISK=131072
VM1_BUILD_TOOLS=1
VM1_UI_LANGUAGE="en-US"     # must match the ISO: en-us ISO

# VM2: x64 under full emulation (no hypervisor). x64 checks only; slow.
VM2_NAME="weldap-win10-x64"
VM2_ARCH="x86_64"
VM2_ISO="vm/iso/Win10_x64.iso"
VM2_EDITION="Windows 10 Pro"
VM2_COMPUTER="WELDAP-W10X64"
VM2_MEMORY=8192
VM2_CPUS=4
VM2_DISK=65536
VM2_BUILD_TOOLS=0
VM2_UI_LANGUAGE="en-GB"     # must match the ISO: "English International" = en-GB

# Shared settings
INPUT_LOCALE="en-GB"        # keyboard
USER_LOCALE="en-GB"
TIME_ZONE="GMT Standard Time"
BREAKGLASS_USER="breakglass"
GUEST_TOOLS_ISO="vm/cache/utm-guest-tools.iso"
GUEST_TOOLS_URL="https://getutm.app/downloads/utm-guest-tools-latest.iso"
