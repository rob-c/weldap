    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../client/Weldap.Core/Weldap.Core.csproj" />
  </ItemGroup>
</Project>
