<?xml version="1.0" encoding="utf-8"?>
<!-- WELDAP credential provider (native COM in-proc server loaded by LogonUI).
     Build: build.ps1 (Release, x64 + ARM64, static CRT). -->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E3F6B52-2C41-4D7A-9B1E-5A0C7D3E9F21}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>WeldapCredentialProvider</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <!-- Spectre v1 (/Qspectre) is opt-in: it needs the "VC Spectre-mitigated libraries" VS component installed
         for every toolset+arch. Build with -p:SpectreMitigation=Spectre once that component is present. The
         default hardening below (CFG, CET shadow stack on x64, high-entropy ASLR, DEP, /GS, /sdl, static CRT,
         no symbols) stands on its own. -->
    <SpectreMitigation Condition="'$(SpectreMitigation)' == ''">false</SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>WeldapCredentialProvider</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\out\$(Platform)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\obj\$(Platform)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <!-- /analyze (MSVC code analysis): with TreatWarningAsError its C6xxx/C28xxx warnings fail the build. -->
      <EnablePREfast>true</EnablePREfast>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Ship no debug symbols: no PDB is produced, and nothing a reverse engineer can lean on is emitted. -->
      <DebugInformationFormat>None</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <ModuleDefinitionFile>WeldapCredentialProvider.def</ModuleDefinitionFile>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <AdditionalOptions>/guard:cf /HIGHENTROPYVA /DYNAMICBASE /NXCOMPAT %(AdditionalOptions)</AdditionalOptions>
      <AdditionalDependencies>secur32.lib;shlwapi.lib;credui.lib;advapi32.lib;bcrypt.lib;crypt32.lib;ole32.lib;user32.lib;gdi32.lib;kernel32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <CETCompat>true</CETCompat>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Dll.cpp" />
    <ClCompile Include="guid.cpp" />
    <ClCompile Include="helpers.cpp" />
    <ClCompile Include="WeldapClient.cpp" />
    <ClCompile Include="WeldapCredential.cpp" />
    <ClCompile Include="WeldapProvider.cpp" />
    <ClCompile Include="WeldapSeal.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\Weldap.Shared\WeldapProtocol.h" />
    <ClInclude Include="common.h" />
    <ClInclude Include="Dll.h" />
    <ClInclude Include="guid.h" />
    <ClInclude Include="helpers.h" />
    <ClInclude Include="WeldapClient.h" />
    <ClInclude Include="WeldapCredential.h" />
    <ClInclude Include="WeldapProvider.h" />
    <ClInclude Include="WeldapSeal.h" />
    <ClInclude Include="resource.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="resources.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="WeldapCredentialProvider.def" />
    <Image Include="tileimage.bmp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
