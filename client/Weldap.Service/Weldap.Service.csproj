<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows service: pipe server, LDAPS (wldap32), local accounts (netapi32), event log. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Weldap.Service</RootNamespace>
    <AssemblyName>WeldapService</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Passwords must not end up in crash dumps of a bloated heap; keep the GC simple. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Ship no debug symbols (no .pdb), and no source/commit metadata in the binary. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- SR-11: laptops get no separate .NET runtime. `dotnet publish -r win-x64|win-arm64` (see build.sh). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>
  <!-- Event Viewer loads message text from this resource DLL by path, so it must sit on disk next to
       the exe (the MSI registers the "WELDAP" source against it), not inside the single-file bundle. -->
  <Target Name="KeepEventLogMessagesOnDisk" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'System.Diagnostics.EventLog.Messages.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Weldap.Core/Weldap.Core.csproj" />
  </ItemGroup>
</Project>
